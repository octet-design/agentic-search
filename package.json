{
  "name": "drape",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check": "node --env-file-if-exists=.env.local --import tsx scripts/check-env.ts",
    "discover": "node --env-file-if-exists=.env.local --import tsx scripts/discover.ts",
    "build:taxonomy": "node --env-file-if-exists=.env.local --import tsx scripts/build-taxonomy.ts",
    "eval": "node --env-file-if-exists=.env.local --import tsx scripts/eval.ts",
    "eval:chat": "node --env-file-if-exists=.env.local --import tsx scripts/eval-chat.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.3",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "openai": "^7.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0",
    "typesense": "^3.0.6",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
