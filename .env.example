TYPESENSE_HOST=http://<host>:8108      # parsed into protocol/host/port for the client
TYPESENSE_SEARCH_KEY=
TYPESENSE_COLLECTION=products

OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-4.1-mini          # intent extraction, rerank, refine agent
OPENAI_MODEL_VISION=gpt-4.1-mini        # image search (must accept image input)
OPENAI_MODEL_OFFLINE=gpt-4.1            # one-off taxonomy build script

NEXT_PUBLIC_APP_NAME=Drape

# Shopify tab (/shopify). Separate from Drape; all optional.
SHOPIFY_CATALOG_URL=https://catalog.shopify.com/api/ucp/mcp
# Must be publicly reachable by Shopify. After deploy: https://<your-domain>/ucp/agent-profile.json
SHOPIFY_UCP_PROFILE_URL=https://shopify.dev/ucp/agent-profiles/examples/2026-08-25/valid-with-capabilities.json
SHOPIFY_COUNTRY=IN                      # buyer country: prices, currency, shipping
